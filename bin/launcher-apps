#!/bin/sh
# Prints one "label<TAB>package/activity" line per launchable app.
# Labels need `aapt` (pkg install aapt). Without it the package name is the label.
set -eu

have_aapt=0
command -v aapt >/dev/null 2>&1 && have_aapt=1

cmd package query-activities --brief \
  -a android.intent.action.MAIN -c android.intent.category.LAUNCHER |
  sed -n 's/^ *\([A-Za-z0-9_.]*\/[A-Za-z0-9_.$]*\) *$/\1/p' |
  sort -u |
  while read -r component; do
    pkg=${component%%/*}
    label=
    if [ "$have_aapt" = 1 ]; then
      apk=$(pm path "$pkg" 2>/dev/null | sed -n '1s/^package://p')
      if [ -n "$apk" ]; then
        label=$(aapt dump badging "$apk" 2>/dev/null |
          sed -n "s/^application-label:'\(.*\)'\$/\1/p" | head -n 1)
      fi
    fi
    printf '%s\t%s\n' "${label:-$pkg}" "$component"
  done
